@page "/student-results"

@rendermode InteractiveServer

@using StudentResultApp.Models
@using StudentResultApp.Services

@inject StudentResultService StudentResultService
@inject ModuleService ModuleService

<PageTitle>Student Results - SRMS</PageTitle>

<div class="student-results-page">

    <div class="page-header">

        <div>
            <h1>Student Results</h1>

            <p>
                Capture, manage and review student academic results.
            </p>
        </div>

    </div>


    <div class="result-card">

        <div class="result-card-header">

            <div>
                <h5>
                    @(isEditing
                        ? "Edit Student Result"
                        : "Capture Student Result")
                </h5>

                <p>
                    Enter the student information and academic mark.
                </p>
            </div>

        </div>


        <EditForm Model="studentResult"
                  OnValidSubmit="SaveResult"
                  FormName="StudentResultForm">

            <DataAnnotationsValidator />

            <div class="result-card-body">

                <div class="form-grid">

                    <div class="form-group-custom">

                        <label>
                            Student Number
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="studentResult.StudentNumber"
                                   placeholder="e.g. STU001" />

                        <ValidationMessage For="@(() => studentResult.StudentNumber)" />

                    </div>


                    <div class="form-group-custom">

                        <label>
                            Full Name
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="studentResult.FullName"
                                   placeholder="Enter student full name" />

                        <ValidationMessage For="@(() => studentResult.FullName)" />

                    </div>


                    <div class="form-group-custom">

                        <label>
                            Module
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="studentResult.ModuleId">

                            <option value="0">
                                Select module
                            </option>

                            @foreach (var module in modules)
                            {
                                <option value="@module.Id">
                                    @module.Code - @module.Name
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => studentResult.ModuleId)" />

                    </div>


                    <div class="form-group-custom">

                        <label>
                            Mark
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="studentResult.Mark" />

                        <ValidationMessage For="@(() => studentResult.Mark)" />

                    </div>

                </div>


                <div class="form-actions">

                    @if (isEditing)
                    {
                        <button type="button"
                                class="btn btn-light"
                                @onclick="CancelEdit">

                            Cancel

                        </button>
                    }

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">

                        @(isSaving
                            ? "Saving..."
                            : isEditing
                                ? "Save Changes"
                                : "Save Student Result")

                    </button>

                </div>

            </div>

        </EditForm>

    </div>


    <div class="result-table-card">

        <div class="table-toolbar">

            <div>
                <h5>Student Results</h5>

                <p>
                    @studentResults.Count result(s) captured
                </p>
            </div>


            <div class="filters">

                <input class="form-control search-box"
                       placeholder="Search students..."
                       @bind="searchText"
                       @bind:event="oninput" />

                <select class="form-select result-filter"
                        @bind="resultFilter">

                    <option value="">
                        All Results
                    </option>

                    <option value="Pass">
                        Pass
                    </option>

                    <option value="Fail">
                        Fail
                    </option>

                </select>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table result-table">

                <thead>

                    <tr>
                        <th>Student No.</th>
                        <th>Full Name</th>
                        <th>Module</th>
                        <th>Mark</th>
                        <th>Result</th>
                        <th class="text-end">Actions</th>
                    </tr>

                </thead>


                <tbody>

                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6"
                                class="empty-state">

                                Loading student results...

                            </td>
                        </tr>
                    }
                    else if (!FilteredResults.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="empty-state">

                                No student results captured yet.

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredResults)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.StudentNumber
                                    </strong>
                                </td>

                                <td>
                                    @item.FullName
                                </td>

                                <td>
                                    @if (item.Module != null)
                                    {
                                        <span class="module-code">
                                            @item.Module.Code
                                        </span>

                                        <span class="module-name">
                                            @item.Module.Name
                                        </span>
                                    }
                                </td>

                                <td>

                                    <strong>
                                        @item.Mark%
                                    </strong>

                                </td>

                                <td>

                                    @if (item.Result == "Pass")
                                    {
                                        <span class="status-badge pass">
                                            ● Pass
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge fail">
                                            ● Fail
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <button class="action-button edit"
                                            @onclick="() => EditResult(item)">

                                        Edit

                                    </button>

                                    <button class="action-button delete"
                                            @onclick="() => OpenDeleteModal(item)">

                                        Delete

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@if (showDeleteModal && resultToDelete != null)
{
    <div class="modal-backdrop-custom">

        <div class="delete-modal">

            <div class="delete-icon">
                !
            </div>

            <h4>
                Delete Student Result?
            </h4>

            <p>
                Are you sure you want to delete the result for
                <strong>@resultToDelete.FullName</strong>?
            </p>

            <p class="delete-warning">
                This action cannot be undone.
            </p>

            <div class="delete-actions">

                <button class="btn btn-light"
                        @onclick="CloseDeleteModal">

                    Cancel

                </button>

                <button class="btn btn-danger"
                        @onclick="DeleteResult"
                        disabled="@isDeleting">

                    @(isDeleting
                        ? "Deleting..."
                        : "Delete Result")

                </button>

            </div>

        </div>

    </div>
}


@code {

    private List<StudentResult> studentResults = new();

    private List<Module> modules = new();

    private StudentResult studentResult = new();

    private StudentResult? resultToDelete;


    private bool isLoading;

    private bool isSaving;

    private bool isDeleting;

    private bool isEditing;

    private bool showDeleteModal;


    private string searchText = string.Empty;

    private string resultFilter = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }


    private IEnumerable<StudentResult> FilteredResults
    {
        get
        {
            IEnumerable<StudentResult> result = studentResults;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(r =>
                    r.StudentNumber.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    r.FullName.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    (r.Module != null &&
                     r.Module.Code.Contains(
                         searchText,
                         StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(resultFilter))
            {
                result = result.Where(r =>
                    r.Result == resultFilter);
            }

            return result;
        }
    }


    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;

            studentResults =
                await StudentResultService.GetAllAsync();

            modules =
                await ModuleService.GetAllAsync();
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SaveResult()
    {
        if (isSaving)
            return;

        try
        {
            isSaving = true;

            if (isEditing)
            {
                await StudentResultService.UpdateAsync(
                    studentResult);
            }
            else
            {
                await StudentResultService.AddAsync(
                    studentResult);
            }

            await LoadDataAsync();

            ResetForm();
        }
        finally
        {
            isSaving = false;
        }
    }


    private void EditResult(StudentResult item)
    {
        isEditing = true;

        studentResult = new StudentResult
        {
            Id = item.Id,
            StudentNumber = item.StudentNumber,
            FullName = item.FullName,
            ModuleId = item.ModuleId,
            Mark = item.Mark,
            Result = item.Result
        };
    }


    private void CancelEdit()
    {
        ResetForm();
    }


    private void ResetForm()
    {
        isEditing = false;

        studentResult = new StudentResult();
    }


    private void OpenDeleteModal(StudentResult item)
    {
        resultToDelete = item;

        showDeleteModal = true;
    }


    private void CloseDeleteModal()
    {
        resultToDelete = null;

        showDeleteModal = false;
    }


    private async Task DeleteResult()
    {
        if (resultToDelete == null || isDeleting)
            return;

        try
        {
            isDeleting = true;

            await StudentResultService.DeleteAsync(
                resultToDelete.Id);

            await LoadDataAsync();

            CloseDeleteModal();
        }
        finally
        {
            isDeleting = false;
        }
    }
}